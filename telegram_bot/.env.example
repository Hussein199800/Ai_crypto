# من https://my.telegram.org  ->  API development tools
TG_API_ID=123456
TG_API_HASH=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# توكن بوتك الخاص من @BotFather
CONTROL_BOT_TOKEN=123456:ABC-xxxxxxxx

# رقمك على تيلجرام (احصل عليه من @userinfobot) — البوت لا يرد على غيرك
OWNER_ID=111111111

# يوزر بوت 360 المدفوع (بدون رابط)، مثال: @Bot360xxx
SOURCE_BOT=@REPLACE_ME

# اختياري: الأدوات لكل إطار (أسماء الأزرار كما تظهر)
# SCALP_TOOLS=SCALPING,PIVOT,DEMARK,STATS
# SWING_TOOLS=TREND,SWING,PIVOT,MURREY,SQ9,CYCLE180,G3,G5,G6

# اختياري: التوقيت بالثواني
# REPLY_QUIET_SECONDS=4
# REPLY_MAX_SECONDS=45
# PAUSE_BETWEEN_TOOLS=3

# ===== الخبراء (ضع مفتاحًا واحدًا على الأقل) =====
# مفتاح واحد = خبير واحد، وأكثر من مفتاح = لجنة تصوّت
# بدون أي مفتاح يعمل البوت بمحرك القواعد فقط

# Gemini — الأسهل والمجاني: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# البحث في جوجل عن الأخبار (للحساب المدفوع فقط): 1 للتشغيل
# GEMINI_SEARCH=0

# ChatGPT — https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6.2-sol

# Claude — https://console.anthropic.com
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=high
