// CryptoScope AI — مخطط قاعدة البيانات
// PostgreSQL + Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── المستخدمون والمصادقة ─────────────────────────

enum UserRole {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  // تجزئة bcrypt فقط — لا تُخزَّن كلمات المرور أبدًا بشكل مكشوف
  passwordHash  String?
  image         String?
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts            Account[]
  sessions            Session[]
  reports             AnalysisReport[]
  watchlist           Watchlist[]
  alerts              Alert[]
  alertEvents         AlertEvent[]
  passwordResetTokens PasswordResetToken[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// رموز تأكيد البريد (يُخزَّن فيها تجزئة SHA-256 للرمز وليس الرمز نفسه)
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ───────────────────────── الأصول وبيانات السوق ─────────────────────────

enum AssetKind {
  CRYPTO
  STABLECOIN
  DOMINANCE
  INDEX
  PAIR
}

model Asset {
  id            String    @id @default(cuid())
  symbol        String    @unique
  name          String
  nameAr        String?
  kind          AssetKind @default(CRYPTO)
  coingeckoId   String?
  binanceSymbol String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  reports AnalysisReport[]

  @@index([kind])
}

// لقطة دورية لبيانات السوق العامة — تُستخدم لبناء تاريخ BTC.D وUSDT.D وTOTAL
model MarketSnapshot {
  id                 String   @id @default(cuid())
  source             String
  totalMarketCap     Float
  totalVolume24h     Float?
  btcMarketCap       Float?
  ethMarketCap       Float?
  usdtMarketCap      Float?
  btcDominance       Float?
  ethDominance       Float?
  usdtDominance      Float?
  marketCapChange24h Float?
  fearGreed          Int?
  isMock             Boolean  @default(false)
  createdAt          DateTime @default(now())

  @@index([createdAt])
  @@index([isMock, createdAt])
}

model OHLCV {
  id        String   @id @default(cuid())
  symbol    String
  timeframe String
  time      DateTime
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float
  source    String
  createdAt DateTime @default(now())

  @@unique([symbol, timeframe, time])
  @@index([symbol, timeframe, time])
}

model IndicatorSnapshot {
  id        String   @id @default(cuid())
  reportId  String?
  symbol    String
  timeframe String
  values    Json
  createdAt DateTime @default(now())

  report AnalysisReport? @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([symbol, timeframe, createdAt])
  @@index([reportId])
}

// ───────────────────────── التقارير التحليلية ─────────────────────────

enum Horizon {
  SHORT
  MEDIUM
  LONG
}

enum Recommendation {
  POSSIBLE_BUY
  GRADUAL_BUY
  NEUTRAL
  REDUCE_RISK
  NO_BUY
  POSSIBLE_SELL
  MARKET_INDICATOR
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

model AnalysisReport {
  id              String         @id @default(cuid())
  symbol          String
  assetName       String
  userId          String?
  // التقارير العامة يراها الجميع، والخاصة يراها مالكها فقط
  isPublic        Boolean        @default(true)
  horizon         Horizon
  recommendation  Recommendation
  riskLevel       RiskLevel
  rawScore        Int
  score           Int
  confidence      Int
  dataQuality     Int
  positiveCount   Int            @default(0)
  negativeCount   Int            @default(0)
  neutralCount    Int            @default(0)
  priceAtAnalysis Float?
  change24h       Float?
  isMock          Boolean        @default(false)
  sources         String[]
  data            Json
  createdAt       DateTime       @default(now())

  user       User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  asset      Asset               @relation(fields: [symbol], references: [symbol])
  indicators IndicatorSnapshot[]

  @@index([symbol, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([recommendation])
  @@index([score])
  @@index([confidence])
  @@index([isPublic, isMock, createdAt])
}

// ───────────────────────── المفضلة والتنبيهات ─────────────────────────

model Watchlist {
  id        String   @id @default(cuid())
  userId    String
  symbol    String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, symbol])
  @@index([userId, position])
}

enum AlertType {
  PRICE_MOVE
  SUPPORT_BREAK
  RESISTANCE_BREAK
  BTC_D_CHANGE
  USDT_D_RISE
  EMA_CROSS
  TREND_CHANGE
}

model Alert {
  id              String    @id @default(cuid())
  userId          String
  symbol          String
  type            AlertType
  threshold       Float?
  isActive        Boolean   @default(true)
  // فترة التهدئة لمنع تكرار التنبيه
  cooldownMinutes Int       @default(240)
  lastTriggeredAt DateTime?
  lastState       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  events AlertEvent[]

  @@index([userId])
  @@index([symbol])
  @@index([isActive])
}

model AlertEvent {
  id        String    @id @default(cuid())
  alertId   String
  userId    String
  message   String
  value     Float?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  alert Alert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ───────────────────────── سجل مزودي البيانات ─────────────────────────

// لا تُسجَّل أي مفاتيح أو أسرار — المسار فقط دون معاملات الاستعلام الحساسة
model DataProviderLog {
  id         String   @id @default(cuid())
  provider   String
  endpoint   String
  status     Int?
  ok         Boolean
  durationMs Int
  error      String?
  createdAt  DateTime @default(now())

  @@index([provider, createdAt])
  @@index([createdAt])
}
