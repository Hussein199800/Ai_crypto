# ─────────────────────────────────────────────────────────────
# CryptoScope AI — متغيرات البيئة
# انسخ هذا الملف إلى .env ثم املأ القيم. لا ترفع ملف .env إلى Git أبدًا.
# ─────────────────────────────────────────────────────────────

# قاعدة البيانات PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cryptoscope?schema=public"

# المصادقة (NextAuth) — ولّد قيمة قوية: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL="http://localhost:3000"

# مصادر البيانات (كلها اختيارية — المصادر المجانية تعمل دون مفاتيح بحدود استخدام أقل)
COINGECKO_API_KEY=
# demo أو pro — نوع مفتاح CoinGecko
COINGECKO_API_PLAN="demo"
COINMARKETCAP_API_KEY=
# مفاتيح Binance غير مطلوبة لبيانات الشموع العامة (تُستخدم للقراءة فقط إن وُجدت)
BINANCE_API_KEY=
BINANCE_API_SECRET=
# عنوان بيانات Binance العامة (data-api.binance.vision متاح دون قيود جغرافية)
BINANCE_BASE_URL="https://data-api.binance.vision"
# TradingView: يُستخدم فقط عبر تكامل رسمي/مرخّص. اتركه فارغًا لاستخدام الرسوم المحلية.
TRADINGVIEW_API_KEY=
# مزود أخبار اختياري (CryptoPanic)
CRYPTOPANIC_API_KEY=

# مفتاح حماية مسارات المهام المجدولة /api/cron/*
CRON_SECRET=

# وضع البيانات: live (مصادر حقيقية) أو mock (بيانات تجريبية للتطوير المحلي فقط)
# ملاحظة: وضع mock يُعطَّل تلقائيًا في الإنتاج.
DATA_MODE="live"

# تسجيل الدخول عبر Google (اختياري)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# البريد (اختياري) — بدون SMTP تُطبع روابط التحقق في سجل الخادم أثناء التطوير
SMTP_URL=
EMAIL_FROM="CryptoScope AI <no-reply@cryptoscope.local>"
# اشتراط تأكيد البريد قبل تسجيل الدخول (true/false)
REQUIRE_EMAIL_VERIFICATION="true"
